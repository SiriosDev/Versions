            "hash": "186e1240abb5330b34b009cd17cf1a3f1c9281b0dfeb053318fd26e6d90f866f"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/acn3hsfcfs73czezm6o3sienbsoq_157.0.8089.0/157.0.8089.0_chrome_installer_uncompressed.exe#/dl.7z",
